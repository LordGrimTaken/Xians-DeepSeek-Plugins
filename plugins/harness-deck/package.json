{
  "name": "@local/harness-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lamprey-style right workspace deck for the DeepSeek Harness Web UI.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "NOTES.md"
  ],
  "dsh": {
